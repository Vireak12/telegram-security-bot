# Copy to .env.local and fill in

TELEGRAM_BOT_TOKEN=
VIRUSTOTAL_API_KEY=

# Any random string (A-Z a-z 0-9 _ -). Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional but recommended on Vercel/serverless (persistent 24h cache).
# Without these, an in-memory cache is used (resets on cold starts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: private alerts when malware is blocked (Option 5)
# Comma-separated Telegram user IDs (message @userinfobot to get yours)
TELEGRAM_ADMIN_USER_IDS=
# Or a dedicated log channel/group chat ID (bot must be a member)
TELEGRAM_ADMIN_LOG_CHAT_ID=
