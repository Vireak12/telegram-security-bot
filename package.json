{
  "name": "telegram-security-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --use-system-ca ./node_modules/next/dist/bin/next start",
    "tunnel": ".\\cloudflared.exe tunnel --url http://localhost:3000",
    "set-webhook": "node --env-file=.env.local scripts/set-webhook.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0",
    "grammy": "^1.30.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}
